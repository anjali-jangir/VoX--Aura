# ── VoxAura AI Voice Studio · environment config ──
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env to git — it holds your secret API key.

# Your ElevenLabs API key (elevenlabs.io → Profile → API Keys)
# The key is read ONLY by server.js and is never sent to the browser.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs model to use (eleven_multilingual_v2 supports 29 languages)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Port the studio runs on
PORT=3000

# ── Optional: override default voice IDs ──
# Find IDs at elevenlabs.io/app/voices (click a voice → "ID"), or via GET /api/voices.
# These map to the voices pre-loaded in script.js; override whichever you like.
# VOICE_FEMALE_RACHEL=21m00Tcm4TlvDq8ikWAM
# VOICE_MALE_ADAM=pNInz6obpgDQGcFmaJgB
